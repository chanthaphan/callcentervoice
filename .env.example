# ── Server ────────────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
# Optional shared secret. Leave blank for local-only use (default). When set, every
# /api/* request must send this value in the X-API-Key header (the bundled UI prompts
# for it once and remembers it). Recommended if you bind APP_HOST to a non-localhost address.
APP_API_KEY=
WATCH_FOLDER=voice
DATA_DIR=data
MAX_PARALLEL_FILES=3
AUTO_PROCESS_ON_START=true
SCAN_INTERVAL_SECONDS=30

# ── Transcription ─────────────────────────────────────────────────────────────
# Options: mock | openai | openai_realtime
# mock works without any API key — good for local testing.
TRANSCRIBE_PROVIDER=mock

OPENAI_API_KEY=

# --- openai (batch Whisper) ---
OPENAI_TRANSCRIBE_MODEL=whisper-1
# For built-in diarization: OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_CHUNKING_STRATEGY=auto
OPENAI_TRANSCRIBE_LANGUAGE=th
OPENAI_REQUEST_TIMEOUT_SECONDS=600
AUDIO_TRANSCODE_BITRATE=64k

# --- openai_realtime (streaming WebSocket) ---
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_TRANSCRIPTION_DELAY=minimal
REALTIME_SAMPLE_RATE=24000
REALTIME_CHUNK_SECONDS=5
REALTIME_CHUNK_TIMEOUT_SECONDS=60
REALTIME_PARTIAL_UPDATE_EVERY_SEGMENTS=3

# --- Speaker diarization ---
# alternating — labels segments A/B by turn order (works with any provider)
# channel     — splits stereo channels into separate speakers (telephony recordings)
# none        — all segments labeled Unknown
LOCAL_DIARIZATION_STRATEGY=alternating

# ── LLM Analysis ──────────────────────────────────────────────────────────────
# Options: mock | openai | azure_openai | anthropic
# mock works without any API key.
LLM_PROVIDER=mock

ANALYSIS_LANGUAGE=Thai
LLM_REQUEST_TIMEOUT_SECONDS=300

# --- openai ---
OPENAI_MODEL=gpt-4.1-mini

# --- azure_openai ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- anthropic ---
ANTHROPIC_API_KEY=
# Fastest for high-volume batches: claude-haiku-4-5-20251001
# Better quality: claude-sonnet-4-6
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── Azure AI Speech Service ───────────────────────────────────────────────────
# Used when TRANSCRIBE_PROVIDER=azure_speech.
# Synchronous Fast Transcription API — no polling, results returned directly.
# Endpoint is derived from AZURE_SPEECH_REGION automatically.

AZURE_SPEECH_API_KEY=
AZURE_SPEECH_REGION=eastus2

# Primary language (BCP-47 locale). Used unless AZURE_SPEECH_LANGUAGE_CANDIDATES is set.
AZURE_SPEECH_LANGUAGE=th-TH

# Speaker separation:
#   diarization → AI-based (mono/mixed audio) → "Speaker 1" / "Speaker 2"
#   channel     → stereo-channel split (agent ch0, customer ch1) → "Agent" / "Customer"
#   none        → no separation (LLM assigns roles from content)
AZURE_SPEECH_DIARIZATION=diarization

# Auto-detect language per segment from a comma-separated list (overrides AZURE_SPEECH_LANGUAGE).
# Example: th-TH,en-US
AZURE_SPEECH_LANGUAGE_CANDIDATES=

# Punctuation mode: DictatedAndAutomatic | Automatic | Dictated | None
AZURE_SPEECH_PUNCTUATION_MODE=DictatedAndAutomatic

# ── Azure Language Service (post-call enrichment) ─────────────────────────────
# Adds PII redaction, per-utterance sentiment, and call summarization after
# the LLM analysis step. Uses the same Cognitive Services resource as
# transcription by default — leave AZURE_LANGUAGE_ENDPOINT and
# AZURE_LANGUAGE_API_KEY blank to reuse AZURE_OPENAI_TRANSCRIBE_ENDPOINT
# and AZURE_OPENAI_API_KEY.
#
# Only applies when AZURE_OPENAI_API_KEY and AZURE_OPENAI_TRANSCRIBE_ENDPOINT
# (or AZURE_LANGUAGE_* below) are set. Gracefully skipped otherwise.
AZURE_LANGUAGE_ENABLED=true

# Azure AI Language resource endpoint and key (REQUIRED for enrichment to run).
# This is a SEPARATE resource from Azure OpenAI — create one at:
#   https://portal.azure.com/#create/Microsoft.CognitiveServicesTextAnalytics
# Format: https://<your-language-resource>.cognitiveservices.azure.com/
# If AZURE_LANGUAGE_ENDPOINT is blank, all Language enrichment is skipped (no 401 errors).
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_API_KEY=

# PII Redaction: replaces names, phone numbers, IDs with [redacted] in stored transcripts.
AZURE_LANGUAGE_PII_REDACTION=true

# Per-utterance sentiment: adds positive/negative/neutral scores to each segment.
AZURE_LANGUAGE_SENTIMENT=true

# Conversation Summarization: extracts issue, resolution, narrative, and follow-up tasks.
# Note: Azure summarization fully supports English; Thai support is limited and degrades gracefully.
AZURE_LANGUAGE_SUMMARIZATION=true
