# ── Server ────────────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
WATCH_FOLDER=voice
DATA_DIR=data
MAX_PARALLEL_FILES=3
AUTO_PROCESS_ON_START=true
SCAN_INTERVAL_SECONDS=30

# ── Transcription ─────────────────────────────────────────────────────────────
# Options: mock | openai | openai_realtime
# mock works without any API key — good for local testing.
TRANSCRIBE_PROVIDER=mock

OPENAI_API_KEY=

# --- openai (batch Whisper) ---
OPENAI_TRANSCRIBE_MODEL=whisper-1
# For built-in diarization: OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_CHUNKING_STRATEGY=auto
OPENAI_TRANSCRIBE_LANGUAGE=th
OPENAI_REQUEST_TIMEOUT_SECONDS=600
AUDIO_TRANSCODE_BITRATE=64k

# --- openai_realtime (streaming WebSocket) ---
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_TRANSCRIPTION_DELAY=minimal
REALTIME_SAMPLE_RATE=24000
REALTIME_CHUNK_SECONDS=5
REALTIME_CHUNK_TIMEOUT_SECONDS=60
REALTIME_PARTIAL_UPDATE_EVERY_SEGMENTS=3

# --- Speaker diarization ---
# alternating — labels segments A/B by turn order (works with any provider)
# channel     — splits stereo channels into separate speakers (telephony recordings)
# none        — all segments labeled Unknown
LOCAL_DIARIZATION_STRATEGY=alternating

# ── LLM Analysis ──────────────────────────────────────────────────────────────
# Options: mock | openai | azure_openai | anthropic
# mock works without any API key.
LLM_PROVIDER=mock

ANALYSIS_LANGUAGE=Thai
LLM_REQUEST_TIMEOUT_SECONDS=300

# --- openai ---
OPENAI_MODEL=gpt-4.1-mini

# --- azure_openai ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- anthropic ---
ANTHROPIC_API_KEY=
# Fastest for high-volume batches: claude-haiku-4-5-20251001
# Better quality: claude-sonnet-4-6
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
