APP_HOST=127.0.0.1
APP_PORT=8000
WATCH_FOLDER=voice
DATA_DIR=data
MAX_PARALLEL_FILES=3
AUTO_PROCESS_ON_START=true
SCAN_INTERVAL_SECONDS=30

# mock keeps the app testable without cloud credentials.
TRANSCRIBE_PROVIDER=mock
# TRANSCRIBE_PROVIDER=openai
# TRANSCRIBE_PROVIDER=openai_realtime
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-realtime-whisper
OPENAI_CHUNKING_STRATEGY=auto
OPENAI_TRANSCRIBE_LANGUAGE=th
OPENAI_REQUEST_TIMEOUT_SECONDS=600
AUDIO_TRANSCODE_BITRATE=64k
LOCAL_DIARIZATION_STRATEGY=alternating
REALTIME_SAMPLE_RATE=24000
REALTIME_CHUNK_SECONDS=10
REALTIME_CHUNK_TIMEOUT_SECONDS=60

# mock, openai, azure_openai, or anthropic
LLM_PROVIDER=mock
ANALYSIS_LANGUAGE=Thai
LLM_REQUEST_TIMEOUT_SECONDS=300
OPENAI_MODEL=gpt-4.1-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
